# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Temporary & editor files
.tmp/
*.swp
*.swo
*~
*.tmp
*.bak
*.old
*.before-*

# Local test caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Test output (screenshots / logs written by tests/*.py)
outputs/

# Local secrets — LLM API keys
data/llm-config.json

# Analysis cache — only the three shipped book graphs + index are tracked;
# chunks/docs/stats stay local and regenerate on demand
data/cache/*
!data/cache/index.json
!data/cache/d16db79a529a1727352091d5.json
!data/cache/a935953b2678a80b352091d5.json
!data/cache/2ef47b2ecaa99a67352091d5.json

# Local tool state
.mirasim/
.claude/

# 宿主/代理工作目录（非产品内容，不入快照）
.agents/
.workbuddy/

# Generated audit output stays outside the product workspace
/artifacts/
/tests/contrast_report.json

# 持续运行环境的状态与日志（只在 loop/ 内追加，不动产品工作树）
loop/state/logs/
loop/state/runs/
loop/state/leases/
# 注意：loop/state/out/ 是证据，**不忽略**（要能进快照、能被复核）
loop/state/GUARD.lock
loop/state/GUARD-HISTORY.jsonl
loop/state/workers/
# 运行时状态快照与任务队列（内部运营产物，不属于产品本体；仅 out/ 证据入库）
loop/state/*
!loop/state/out/
loop/queue/
